<!-- The dev stack's admin user creates and reads named collections: leasehold apply
     keeps the object storage keys ClickHouse reads snapshot files with in one. -->
<clickhouse>
    <users>
        <admin>
            <named_collection_control>1</named_collection_control>
            <show_named_collections>1</show_named_collections>
            <show_named_collections_secrets>1</show_named_collections_secrets>
        </admin>
    </users>
</clickhouse>
